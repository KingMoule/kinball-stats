    { "motif": "^sim/", "suites": ["C13B", "C23"], "commandes": ["node sim/simtest.mjs"] },
    { "motif": "^tests/local/", "suites": [], "commandes": ["node tests/local/kblocal.test.mjs", "node tests/local/collecte.test.mjs"] },
    { "motif": "^outils/check-release\\.mjs$", "suites": ["M04"] },
    { "motif": "^(outils/resync\\.mjs|amont/)", "suites": ["M04", "M06"], "commandes": ["node tests/local/resync.test.mjs"] },
    { "motif": "^(docs/|tests/docs/|tests/README\\.md$|tests/(rapide|resume-ci)\\.(mjs|json)$|\\.claude/|\\.github/|CLAUDE\\.md$|README\\.md$|MIGRATION\\.md$|\\.gitignore$|\\.nojekyll$|outils/(carte|ci-banc)\\.mjs$)", "suites": [] }
  ],

