    { "motif": "^sw\\.js$", "suites": ["M02", "M04"], "commandes": ["node outils/check-release.mjs"] },
    { "motif": "^kblocal\\.js$", "suites": ["M03", "M04", "M05", "M06", "M08", "M11", "C27"], "commandes": ["node tests/local/kblocal.test.mjs", "node outils/check-release.mjs"] },
    { "motif": "^(kbcollect\\.js|config\\.js)$", "suites": ["M04", "M08", "C25", "C28"], "commandes": ["node tests/local/collecte.test.mjs", "node outils/check-release.mjs"] },
    { "motif": "^collecte/", "suites": ["M08"], "commandes": ["node tests/local/collecte.test.mjs"] },
    { "motif": "^(manifest\\.webmanifest|icons/|fonts/|confidentialite\\.html$)", "suites": ["M02", "M04"], "commandes": ["node outils/check-release.mjs"] },
