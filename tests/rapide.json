{
  "_lisez-moi": "Table du banc rapide (tests/rapide.mjs). Indicative : elle dit quelles suites jouer d'abord pour un fichier ou une section modifiée, jamais qu'il suffit de les jouer. Le banc complet (CI) fait foi. Pour une section de index.html, les motifs portent sur le titre donné par `node outils/carte.mjs`. À corriger dès qu'un échec de la CI montre qu'une suite manquait ici.",

  "toujours": ["smoke", "undo"],

  "poids_s": { "smoke": 5, "undo": 26, "fuzz": 75, "C13B": 135, "C14": 13, "C15": 12, "C16": 16, "C17": 8, "C18": 7, "C19": 10, "C20": 8, "C21": 155, "C22": 96, "C23": 138, "C24": 10, "C25": 30, "C26": 30, "C27": 30, "C28": 30, "M02": 2, "M03": 21, "M04": 33, "M05": 18, "M06": 18, "M08": 37, "M11": 16 },

  "fichiers": [
    { "motif": "^tests/scenarios/([^/]+)\\.mjs$", "suites": ["$1"] },
    { "motif": "^tests/(smoke|undo|fuzz)\\.mjs$", "suites": ["$1"] },
    { "motif": "^tests/(lib|model|run|empreinte|serveur|attendre)\\.mjs$", "suites": [], "complet_requis": "l'outillage du banc a changé" },
    { "motif": "^kbsite\\.js$", "suites": ["M04", "M06", "M08"] },
    { "motif": "^sw\\.js$", "suites": ["M02", "M04"] },
    { "motif": "^kblocal\\.js$", "suites": ["M03", "M05", "M06", "M11", "C27"], "commandes": ["node tests/local/kblocal.test.mjs"] },
    { "motif": "^(kbcollect\\.js|config\\.js|collecte/)", "suites": ["M08"], "commandes": ["node tests/local/collecte.test.mjs"] },
    { "motif": "^(manifest\\.webmanifest|icons/|fonts/)", "suites": ["M02", "M04"] },
    { "motif": "^vendor/", "suites": ["M02", "C28"] },
    { "motif": "^sim/", "suites": ["C13B"], "commandes": ["node sim/simtest.mjs"] },
    { "motif": "^outils/check-release\\.mjs$", "suites": ["M04"] },
    { "motif": "^(outils/resync\\.mjs|amont/)", "suites": ["M04", "M06"], "commandes": ["node tests/local/resync.test.mjs"] },
    { "motif": "^(docs/|tests/docs/|tests/README\\.md$|tests/(rapide|resume-ci)\\.(mjs|json)$|\\.claude/|\\.github/|CLAUDE\\.md$|README\\.md$|MIGRATION\\.md$|confidentialite\\.html$|\\.gitignore$|\\.nojekyll$|outils/carte\\.mjs$)", "suites": [] }
  ],

  "avant_les_sections": { "suites": ["C14", "C18", "C19", "C20"], "gabarit": "tous", "note": "HTML ou CSS avant la première section du script : la mise en page peut changer sur téléphone" },

  "sections": [
    { "motif": "TÉLÉPHONE", "suites": ["C19", "C20", "C24"], "gabarit": "tous" },
    { "motif": "FORMATS DE MATCH|NOUVEAU MATCH|CHOIX DU FORMAT|SÉLECTEUR D'ÉQUIPES|ALIGNEMENTS|GESTION DES ÉQUIPES", "suites": ["C19", "C25", "C26"] },
    { "motif": "BASE D'ÉQUIPES|STOCKAGE SERVEUR|SYNCHRONISATION|OÙ VIVENT|QUI A PRIS|MIGRATION|CORBEILLE|SAUVEGARDE D'UN MATCH|RÉCUPÉRATION", "suites": ["C26", "C27", "M03", "M06", "M11"] },
    { "motif": "^NAVIGATION", "suites": ["C25", "C26", "fuzz"] },
    { "motif": "JOUEURS PENDANT LE MATCH|Glisser-déposer", "suites": ["C19", "C24"] },
    { "motif": "GARDE-FOUS CONTRE LE FAUX CLIC|^SHEET", "suites": ["C22", "C24", "C26"] },
    { "motif": "MENU RADIAL|FIELD DRAG|JOUEUR DE L'ACTION|REPRISE DE JEU", "suites": ["C20", "C21", "C24", "fuzz"] },
    { "motif": "% DE VICTOIRE EN DIRECT|Générateur à graine|Un pas de règles|^Simulation|Pas de règles pour|Paramètres à partir|^Affichage", "suites": ["C13B"] },
    { "motif": "^STATS\\b|TABLEAUX DE STATISTIQUES|SITUATION DE JEU|STATS INDIVIDUELLES|Sections : statistiques d'UN match", "suites": ["C15", "C16", "C18"] },
    { "motif": "Phases d'une période", "suites": ["C16"] },
    { "motif": "^Par période", "suites": ["C15"] },
    { "motif": "ZONES DE DÉPART|HEAT MAP|GRILLE D'EFFICACITÉ", "suites": ["C17", "C18"] },
    { "motif": "^EXPORT|ENREGISTREMENT DE FICHIER", "suites": ["C25", "C28", "M05"] },
    { "motif": "HISTORIQUE DES MATCHS|STATISTIQUES CUMULÉES|CLASSEMENT|Sections : cumul", "suites": ["C18", "C25", "C26"] },
    { "motif": "SAUVEGARDE / RESTAURATION|ARCHIVAGE|VALIDATION DE L'IMPORT", "suites": ["C25", "C27", "M06", "M11"] }
  ],

  "section_inconnue": { "suites": ["fuzz"], "note": "section non reconnue : ajouter son titre à tests/rapide.json" }
}
